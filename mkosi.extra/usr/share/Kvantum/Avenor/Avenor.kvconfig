[%General]
author=AvenorOS
comment=Warm, quiet surfaces for AvenorOS
x11drag=menubar_and_primary_toolbar
alt_mnemonic=true
left_tabs=true
attach_active_tab=false
group_toolbar_buttons=false
spread_progressbar=true
composite=true
translucent_windows=false
blurring=false
popup_blurring=false
animate_states=true
no_inactiveness=true
no_window_pattern=true
menu_shadow_depth=0
tooltip_shadow_depth=0
scroll_width=8
scroll_min_extent=48
scroll_arrows=false
scrollbar_in_view=true
transient_scrollbar=true
slider_width=4
slider_handle_width=18
slider_handle_length=18
check_size=18
tree_branch_line=false
small_icon_size=16
large_icon_size=32
button_icon_size=16
toolbar_icon_size=18
layout_spacing=8
layout_margin=12
submenu_overlap=0
spin_button_width=20
combo_as_lineedit=false
combo_menu=true
hide_combo_checkboxes=true
fill_rubberband=true
respect_DE=true
dialog_button_layout=0
iconless_pushbutton=true
iconless_menu=false
tooltip_delay=400
center_toolbar_handle=true
transparent_dolphin_view=false
transparent_menutitle=true

[GeneralColors]
window.color=#faf8f5
base.color=#ffffff
alt.base.color=#f6f3ee
button.color=#ffffff
light.color=#ffffff
mid.light.color=#f3efe9
dark.color=#cfc7bd
mid.color=#e4ddd4
highlight.color=#607296
inactive.highlight.color=#8a98b4
text.color=#2e2a26
window.text.color=#2e2a26
button.text.color=#2e2a26
disabled.text.color=#2e2a2666
tooltip.text.color=#2e2a26
highlight.text.color=#ffffff
link.color=#607296
link.visited.color=#7c6a9a
progress.indicator.text.color=#2e2a26

[Hacks]
transparent_ktitle_label=true
respect_darkness=true
blur_konsole=false
iconless_pushbutton=true
normal_default_pushbutton=true
tint_on_mouseover=0
no_selection_tint=true

[PanelButtonCommand]
frame=true
frame.element=button
frame.top=8
frame.bottom=8
frame.left=8
frame.right=8
interior=true
interior.element=button
indicator.element=arrow
indicator.size=12
text.normal.color=#2e2a26
text.focus.color=#2e2a26
text.press.color=#2e2a26
text.toggle.color=#2e2a26
text.disabled.color=#2e2a2666
text.margin.left=10
text.margin.right=10
text.margin.top=4
text.margin.bottom=4
text.iconspacing=6
min_width=+0.5font
min_height=+0.4font

[PanelButtonTool]
inherits=PanelButtonCommand
frame.element=tbutton
interior.element=tbutton
text.margin.left=6
text.margin.right=6

[ToolbarButton]
inherits=PanelButtonTool

[DropDownButton]
inherits=PanelButtonCommand
indicator.element=arrow-down

[ComboBox]
inherits=PanelButtonCommand

[IndicatorSpinBox]
inherits=PanelButtonCommand
frame.element=button
interior.element=button

[IndicatorArrow]
indicator.element=arrow
indicator.size=12

[LineEdit]
inherits=PanelButtonCommand
frame.element=lineedit
interior.element=lineedit

[Focus]
frame=false
interior=false

[GenericFrame]
inherits=PanelButtonCommand
frame=true
interior=true
frame.element=common
interior.element=common
frame.top=12
frame.bottom=12
frame.left=12
frame.right=12

[GroupBox]
inherits=GenericFrame
frame.element=group
interior.element=group
text.margin.top=6

[TabFrame]
inherits=GenericFrame
frame.element=tabframe
interior.element=tabframe

[Tab]
inherits=PanelButtonCommand
frame.element=tab
interior.element=tab
text.margin.left=12
text.margin.right=12

[TabBarFrame]
frame=false
interior=false

[ToolboxTab]
inherits=PanelButtonCommand

[ItemView]
inherits=PanelButtonCommand
frame.element=itemview
interior.element=itemview
text.margin.left=6
text.margin.right=6
text.toggle.color=#2e2a26
text.press.color=#2e2a26

[HeaderSection]
inherits=PanelButtonCommand
frame.element=header
interior.element=header
frame.top=1
frame.bottom=1
frame.left=1
frame.right=1
text.margin.left=8

[Menu]
inherits=PanelButtonCommand
frame.element=menu
interior.element=menu
frame.top=12
frame.bottom=12
frame.left=12
frame.right=12

[MenuItem]
inherits=PanelButtonCommand
frame=true
frame.element=menuitem
interior.element=menuitem
indicator.element=arrow
frame.top=6
frame.bottom=6
frame.left=6
frame.right=6
text.margin.top=3
text.margin.bottom=3

[MenuBar]
frame=false
interior=false

[MenuBarItem]
inherits=PanelButtonCommand
frame.element=menubaritem
interior.element=menubaritem
frame.top=6
frame.bottom=6
frame.left=6
frame.right=6

[ToolTip]
inherits=GenericFrame
frame.element=tooltip
interior.element=tooltip
frame.top=10
frame.bottom=10
frame.left=10
frame.right=10

[Toolbar]
frame=false
interior=false

[Scrollbar]
inherits=PanelButtonCommand
indicator.size=0

[ScrollbarGroove]
frame=false
interior=false

[ScrollbarSlider]
inherits=PanelButtonCommand
frame.element=scrollbarslider
interior.element=scrollbarslider
frame.top=4
frame.bottom=4
frame.left=4
frame.right=4
indicator.size=0

[Slider]
inherits=PanelButtonCommand
frame.element=slider
interior.element=slider
frame.top=3
frame.bottom=3
frame.left=3
frame.right=3

[SliderCursor]
frame=false
interior=true
interior.element=slidercursor

[Progressbar]
inherits=PanelButtonCommand
frame.element=progress
interior.element=progress
frame.top=4
frame.bottom=4
frame.left=4
frame.right=4

[ProgressbarContents]
inherits=Progressbar
frame.element=progress-pattern
interior.element=progress-pattern

[CheckBox]
frame=false
interior=true
interior.element=checkbox
text.margin.left=6

[RadioButton]
frame=false
interior=true
interior.element=radio
text.margin.left=6

[TreeExpander]
frame=false
interior=false
indicator.element=arrow
indicator.size=12

[Splitter]
frame=false
interior=false

[Dock]
frame=false
interior=false

[DockTitle]
frame=false
interior=false

[TitleBar]
frame=false
interior=false

[StatusBar]
frame=false
interior=false

[Window]
interior=false
frame=false

[SizeGrip]
indicator.size=0
